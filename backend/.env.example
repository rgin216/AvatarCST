PORT=5000
MONGO_URI=
NODE_ENV=development

OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-mini
OPENAI_REALTIME_VOICE=marin
OPENAI_TEXT_MODEL=gpt-5.4-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
OPENAI_TTS_INSTRUCTIONS=Speak warmly, clearly, and gently for an older adult in a cognitive stimulation therapy session.
OPENAI_AUDIO_MODEL=gpt-audio-1.5
OPENAI_AUDIO_VOICE=marin

# Optional Rhubarb Lip Sync override.
# npm install tries to download Rhubarb into backend/vendor/rhubarb/bin automatically.
# Set this only if you want to use a manually installed binary instead.
# Example (Windows): RHUBARB_PATH=C:/tools/rhubarb/rhubarb.exe
# Example (macOS/Linux): RHUBARB_PATH=/usr/local/bin/rhubarb
RHUBARB_PATH=

# Groq (free API - runs Whisper STT + LLaMA LLM in the cloud, no local install needed)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Default pipeline mode for new sessions:
#   free            -> Groq Whisper (STT) -> Groq LLM -> edge-tts (TTS) -> Rhubarb
#   openai-scripted        -> OpenAI STT -> OpenAI text model -> OpenAI TTS -> Rhubarb
#   openai-scripted-energy -> OpenAI STT -> OpenAI text model -> OpenAI TTS -> audio energy lipsync
#   openai-audio           -> OpenAI STT -> OpenAI text model -> OpenAI audio model -> Rhubarb
PIPELINE_MODE=free

# TTS voice for edge-tts (used when PIPELINE_MODE=free)
# NZ voices: en-NZ-MitchellNeural (male), en-NZ-MollyNeural (female)
# Full list: https://learn.microsoft.com/azure/ai-services/speech-service/language-support
TTS_VOICE=en-NZ-MitchellNeural
