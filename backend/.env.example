PORT=5000
MONGO_URI=
NODE_ENV=development

OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.4-mini
OPENAI_FAST_TEXT_MODEL=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
OPENAI_TTS_MALE_VOICE=ash
OPENAI_TTS_FEMALE_VOICE=marin
OPENAI_TTS_INSTRUCTIONS=Speak warmly, clearly, and gently for an older adult in a cognitive stimulation therapy session.

# Optional Rhubarb Lip Sync override.
# On Windows, npm install tries to download Rhubarb into backend/vendor/rhubarb/bin.
# On macOS/Linux, install Rhubarb manually and set RHUBARB_PATH if it is not on PATH.
# Set RHUBARB_PATH to override the vendored Windows binary or point to a manual install.
# Example (Windows): RHUBARB_PATH=C:/tools/rhubarb/rhubarb.exe
# Example (macOS/Linux): RHUBARB_PATH=/usr/local/bin/rhubarb
RHUBARB_PATH=

# Groq (free API - runs Whisper STT + LLaMA LLM in the cloud, no local install needed)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Default pipeline mode for new sessions:
#   free                 -> Groq Whisper (STT) -> Groq LLM -> edge-tts -> Rhubarb for avatars / streaming energy for visualizer
#   openai-fast-scripted -> OpenAI STT -> OpenAI text model -> OpenAI TTS -> Rhubarb for avatars / streaming energy for visualizer
PIPELINE_MODE=free

# TTS voices for edge-tts (used when PIPELINE_MODE=free)
# NZ voices: en-NZ-MitchellNeural (male), en-NZ-MollyNeural (female)
# Full list: https://learn.microsoft.com/azure/ai-services/speech-service/language-support
TTS_VOICE=en-NZ-MitchellNeural
EDGE_TTS_MALE_VOICE=en-NZ-MitchellNeural
EDGE_TTS_FEMALE_VOICE=en-NZ-MollyNeural
